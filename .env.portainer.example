# =============================================================================
# ZeroPeek – production environment template for the Portainer stack
# (docker-compose.portainer.yml)
# =============================================================================
#
# Do NOT commit real values. In Portainer, paste these keys into the stack's
# "Environment variables" editor (see docs/deployment/PORTAINER.md), or upload
# this file as an .env.
#
# The four values below MUST be replaced with your real credentials/secrets;
# every other value already has a correct default. Portainer shows the stack
# environment as a single editor, so setting them all here is enough – the stack
# never fails one variable at a time.
#
#   POSTGRES_PASSWORD   a real, strong password
#   SESSION_SECRET      openssl rand -hex 32
#   (POSTGRES_DB and POSTGRES_USER are already set to `zeropeek`)
#
# The public origin is https://zeropeek.xubi.org and is already the default.
# Reference: docs/deployment/ENVIRONMENT.md
# =============================================================================

# -----------------------------------------------------------------------------
# Image selection – controls which published images the stack runs
# -----------------------------------------------------------------------------
# Tag of both ZeroPeek images. Use `latest` for the newest main build, or pin a
# concrete commit tag such as `sha-1a2b3c4` for a reproducible deployment and
# simple rollbacks (docs/deployment/ROLLBACK.md).
ZEROPEEK_IMAGE_TAG=latest

# Optional overrides if the images ever move to a different registry/namespace.
ZEROPEEK_BACKEND_IMAGE=ghcr.io/dejowebdesign/zeropeek-backend
ZEROPEEK_FRONTEND_IMAGE=ghcr.io/dejowebdesign/zeropeek-frontend

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# All three values are required and must not be empty. The stack refuses to
# deploy if POSTGRES_DB, POSTGRES_USER or POSTGRES_PASSWORD is missing or empty
# (Compose `:?` guard) – an empty password aborts PostgreSQL initialisation and
# the database container ends up `unhealthy`.
#
# POSTGRES_DB, POSTGRES_USER and POSTGRES_PASSWORD are only applied the FIRST
# time the `db-data` volume is initialised. On an existing volume PostgreSQL
# ignores them, so changing them later does NOT change the database user or
# password – the matching values must already be inside the volume.
POSTGRES_DB=zeropeek
POSTGRES_USER=zeropeek
# Generate with: openssl rand -base64 32
# Any characters are allowed; the connection string is built with them encoded.
POSTGRES_PASSWORD=change-me-postgres-password

# Connection string used by the backend (Prisma). OPTIONAL.
#   * Leave it EMPTY (recommended) and the backend builds it from the three
#     values above with URL-safe encoding, so the credentials live in exactly
#     one place:
#       postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>?schema=public
#   * Set it explicitly only when the database is not the `db` service (e.g. an
#     external server). If you do, it MUST repeat exactly the same user,
#     password and database name as above; special characters in the password
#     must be percent-encoded (`@` -> `%40`, `:` -> `%3A`, `/` -> `%2F`).
#   * WARNING: an explicit DATABASE_URL WINS over POSTGRES_*. If it points
#     somewhere else, the backend logs a prominent warning and cannot reach the
#     database – the classic cause of "database not reachable" after an update.
#     When in doubt, delete the value here so it is derived automatically.
# DATABASE_URL=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# OPTIONAL. Host is the compose service name `cache`, so the compose file already
# defaults to the correct value and this line normally needs no change. Set it
# only when Redis runs outside this stack. Redis is used for Socket.IO scaling
# and rate limiting; the backend probes it on start and logs a warning (but keeps
# serving) when it is unreachable, so a cache outage never takes the app down.
# REDIS_URL=redis://cache:6379
REDIS_MAXMEMORY=256mb

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public URL users open in a browser; used for generated links, QR codes and
# cookie scope. Must be an absolute http(s) URL. It already defaults to the
# canonical production origin in docker-compose.portainer.yml, so it only has to
# be set for a different host (e.g. staging). A localhost address is accepted but
# logs a warning, because links and QR codes then only work on the host itself.
APP_BASE_URL=https://zeropeek.xubi.org
# Allowed browser origin for CORS. Leave empty to default to APP_BASE_URL, which
# is correct for same-origin operation. Set it only if the browser origin really
# differs from APP_BASE_URL.
CORS_ORIGIN=https://zeropeek.xubi.org
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Sessions and cookies
# -----------------------------------------------------------------------------
# REQUIRED and must not be empty. A long random value: openssl rand -hex 32.
# The stack refuses to deploy with an empty value, and the backend rejects a
# value that is a placeholder (e.g. this example text) or shorter than 32
# characters – so replace it before deploying.
SESSION_SECRET=change-me-session-secret
SESSION_TTL_HOURS=72
COOKIE_NAME=zp_session
# Session cookie `Secure` flag. The public site is served over HTTPS, so set it
# to `true`. (It is also derived automatically from an `https://` APP_BASE_URL;
# leave it empty only to let that derivation decide.)
COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Reverse proxy (Caddy + Let's Encrypt)
# -----------------------------------------------------------------------------
# ZeroPeek is served over HTTPS at https://zeropeek.xubi.org. The values below
# are the TLS configuration for that domain.
#
#   * HTTPS: ZP_SITE_ADDRESS=<domain>, CADDY_CONTAINER_PORT=443, HTTP_PORT=443.
#   * Plain HTTP (default): leave ZP_SITE_ADDRESS empty, keep
#     CADDY_CONTAINER_PORT=80 and set HTTP_PORT=3737.
HTTP_PORT=443
# Port Caddy listens on inside the container. Must match HTTP_PORT's right-hand
# side: 443 for TLS, 80 for plain HTTP.
CADDY_CONTAINER_PORT=443
# Site address Caddy serves. EMPTY = plain HTTP on :80. The public domain
# enables automatic HTTPS with a Let's Encrypt certificate.
ZP_SITE_ADDRESS=zeropeek.xubi.org
# Host port mapped to the container's port 80, which Caddy uses for the ACME
# HTTP-01 challenge and the HTTP->HTTPS redirect. Let's Encrypt always validates
# the challenge on the host's port 80, so keep this at 80. If another service
# already binds host port 80, set a free port here and forward the host's public
# port 80 to it. Defaults to HTTP_PORT, so it is only distinct in TLS mode
# (HTTP_PORT=443 here).
ZP_HTTP_CHALLENGE_PORT=80
# ACME directory Caddy requests certificates from. EMPTY (the default) uses
# Let's Encrypt production. Set it to the staging directory while testing so a
# misconfiguration cannot consume the production rate limit (50 certificates per
# registered domain per week):
#   ZP_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Certificates and the ACME account are stored in the `caddy-data` volume, so
# they survive restarts and redeploys and are only re-requested when expired.
# Do NOT remove that volume on update, or Caddy re-requests certificates.
ZP_ACME_CA=

# -----------------------------------------------------------------------------
# Optional (only needed from the phase that uses them)
# -----------------------------------------------------------------------------
# Mail delivery for verification / password reset.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=no-reply@example.com
