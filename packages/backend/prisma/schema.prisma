// ZeroPeek – Prisma schema
//
// Phase 0 established the datasource, the generator and a single User model.
// Phase 2 adds the full domain model on top: quizzes and their questions
// (type-specific fields in a JSONB payload, per ADR 0004), games, players,
// per-question answers and server-side sessions.
//
// Nothing from Phase 0 was removed: `User`, `UserRole` and the `users` table
// mapping are unchanged. `Session`, `Quiz` and `Game` were added as relations
// on `User`, so the model above is only extended.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TRAINER
  PLAYER
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String?   @unique
  passwordHash    String    @map("password_hash")
  role            UserRole  @default(TRAINER)
  disabled        Boolean   @default(false)
  /// When the e-mail address was confirmed. `null` means not yet confirmed;
  /// accounts that existed before Phase 6.3 are treated as confirmed by the
  /// migration, and staff accounts created by an admin are confirmed on
  /// creation. Only self-registered players start out `null`.
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  quizzes  Quiz[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

/// A single-use e-mail verification token. Only the SHA-256 hash of the token
/// is stored, so a database leak does not hand out usable links. Rows are
/// deleted as soon as they are consumed or replaced.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Server-side session. The cookie only carries the opaque `id`; everything
/// else (expiry, CSRF token, user) lives here, so a session can be revoked.
model Session {
  id        String   @id
  userId    String   @map("user_id")
  csrfToken String   @map("csrf_token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  lastSeen  DateTime @default(now()) @map("last_seen")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A quiz: an ordered list of questions plus metadata.
model Quiz {
  id               String   @id @default(uuid())
  title            String
  description      String   @default("")
  theme            String   @default("standard")
  defaultTimeLimit Int      @default(20) @map("default_time_limit")
  /// Optional category label (Phase 6.4). Free text; no fixed taxonomy yet.
  category         String?
  /// Optional difficulty label (Phase 6.4). Free text; no fixed taxonomy yet.
  difficulty       String?
  ownerId          String?  @map("owner_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  questions Question[]
  games     Game[]
  snapshots GameSnapshot[]

  @@index([ownerId])
  @@map("quizzes")
}

/// One question. `payload` holds the type-specific fields (options, correct
/// answers, slider bounds, …); its shape is defined and validated by
/// `@zeropeek/shared` (ADR 0004). `position` gives the ordering.
model Question {
  id         String   @id @default(uuid())
  quizId     String   @map("quiz_id")
  type       String
  text       String
  timeLimit  Int      @map("time_limit")
  points     String   @default("standard")
  position   Int
  payload    Json     @default("{}")
  /// Optional category label (Phase 6.4). Free text; no fixed taxonomy yet.
  category   String?
  /// Optional difficulty label (Phase 6.4). Free text; no fixed taxonomy yet.
  difficulty String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, position])
  @@map("questions")
}

/// A game session: one run of a quiz, addressed by a short PIN.
model Game {
  id           String    @id @default(uuid())
  pin          String    @unique
  /// The quiz the game was created from. **Nullable** so deleting a quiz can
  /// never delete the game or its results: the questions a started game uses
  /// live in `GameSnapshot`, not here (Phase 6.4). `null` means the source quiz
  /// is gone; the game is still fully playable and reportable from its snapshot.
  quizId       String?   @map("quiz_id")
  hostId       String?   @map("host_id")
  phase        String    @default("lobby")
  currentIndex Int       @default(-1) @map("current_index")
  /// Scoring settings snapshot (Q1/Q2/Q6), frozen when the game starts so a
  /// later config change never rewrites history.
  settings     Json      @default("{}")
  startedAt    DateTime? @map("started_at")
  endedAt      DateTime? @map("ended_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  quiz     Quiz?         @relation(fields: [quizId], references: [id], onDelete: SetNull)
  players  GamePlayer[]
  events   GameEvent[]
  snapshot GameSnapshot?

  @@index([quizId])
  @@index([phase])
  @@map("games")
}

/// An immutable copy of the quiz a game was started with (Phase 6.4).
///
/// Written once, when the host starts the run. From that moment the engine, the
/// reports and the reconnect paths read the questions **from here**, never from
/// the live, editable `Quiz`. Editing or deleting the quiz therefore cannot
/// change or destroy a round that has already begun (product decision,
/// `game-design-concept.md` §8.7; roadmap §5).
///
/// `payload` is the versioned JSONB envelope defined by `@zeropeek/shared`
/// (`GameSnapshotData`): the full question list – options, correct solutions,
/// types and order – plus the quiz metadata. `quizId` is provenance only and
/// may point at a deleted quiz.
model GameSnapshot {
  id        String   @id @default(uuid())
  gameId    String   @unique @map("game_id")
  quizId    String?  @map("quiz_id")
  /// The snapshot schema version, so a future shape change is detectable.
  version   Int      @default(1)
  /// Denormalised from the payload so the game list and the report header can be
  /// rendered without parsing every snapshot's JSON. The payload stays the
  /// authoritative record; these two only mirror it for cheap reads.
  title         String
  questionCount Int      @map("question_count")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  game Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  quiz Quiz? @relation(fields: [quizId], references: [id], onDelete: SetNull)

  @@index([quizId])
  @@map("game_snapshots")
}

/// A participant in one game. `token` lets a player reclaim their slot after a
/// reconnect without letting anyone else impersonate them.
model GamePlayer {
  id           String   @id @default(uuid())
  gameId       String   @map("game_id")
  nickname     String
  avatar       String   @default("")
  token        String   @unique
  score        Int      @default(0)
  correctCount Int      @default(0) @map("correct_count")
  totalTimeMs  Int      @default(0) @map("total_time_ms")
  team         String?
  joinedAt     DateTime @default(now()) @map("joined_at")
  connected    Boolean  @default(true)

  game    Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers PlayerAnswer[]

  @@unique([gameId, nickname])
  @@index([gameId])
  @@map("game_players")
}

/// One player's answer to one question. `answer` keeps the raw payload for the
/// report; `correctness`/`points` are the server's verdict.
///
/// `questionId` is deliberately **not** a foreign key to `Question` any more
/// (Phase 6.4). A started game answers against its `GameSnapshot`, whose
/// questions are copies; a foreign key to the live `Question` would cascade a
/// deletion of the quiz into a deletion of history (the R-3 risk). The id is
/// kept as a plain string, so answers survive the quiz being edited or deleted.
///
/// `ON DELETE SET NULL` is not a viable alternative either: it would null the id
/// on a quiz delete (and on any editor save, since `updateQuiz` recreates every
/// question row), and the report attributes answers by this id alone. The
/// snapshot, not the live table, is the referential guarantee. See
/// `docs/reports/phase-6-4-quiz-editor-snapshot.md` §7.
model PlayerAnswer {
  id          String   @id @default(uuid())
  gameId      String   @map("game_id")
  playerId    String   @map("player_id")
  questionId  String   @map("question_id")
  answer      Json     @default("null")
  correctness Float    @default(0)
  points      Int      @default(0)
  elapsedMs   Int      @default(0) @map("elapsed_ms")
  flagged     Boolean  @default(false)
  answeredAt  DateTime @default(now()) @map("answered_at")

  player GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, questionId])
  @@index([gameId])
  @@index([questionId])
  @@map("player_answers")
}

/// Append-only log of game transitions, used by the report and for auditing.
model GameEvent {
  id        String   @id @default(uuid())
  gameId    String   @map("game_id")
  type      String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@map("game_events")
}
