# ---------------------------------------------------------------------------
# ZeroPeek – example environment file for LOCAL DEVELOPMENT (docker-compose.yml)
#
#   cp .env.example .env   # then edit values
#
# For the production Portainer stack (docker-compose.portainer.yml) use
# .env.portainer.example instead – see docs/deployment/PORTAINER.md.
# NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
# Port the Fastify backend listens on inside its container / on the host.
BACKEND_PORT=3000
# Public base URL of the frontend (used for QR codes, links, cookie scope).
APP_BASE_URL=http://localhost:8080
# Allowed browser origin for CORS. Defaults to APP_BASE_URL when unset.
CORS_ORIGIN=http://localhost:8080

# PostgreSQL (matches docker-compose.yml service `db`)
POSTGRES_USER=zeropeek
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=zeropeek
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Connection string consumed by Prisma and the backend.
DATABASE_URL=postgresql://zeropeek:change-me-in-production@db:5432/zeropeek?schema=public

# Redis (optional, used for Socket.IO scaling in later phases)
REDIS_URL=redis://cache:6379

# Sessions / cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=please-generate-a-32-byte-hex-secret
COOKIE_NAME=zp_session
SESSION_TTL_HOURS=72
# Set to true behind TLS so cookies are only sent over HTTPS.
COOKIE_SECURE=false

# Mail (Phase 6.3 – account confirmation). Leave empty to disable sending.
SMTP_URL=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=ZeroPeek
MAIL_VERIFY_TTL_HOURS=24

# Enforce the stricter per-route limits on the auth endpoints (default true).
AUTH_RATE_LIMITS=true
